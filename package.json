{
  "name": "mysql-mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop bridge that exposes MySQL servers to MCP clients through a secure local MCP endpoint and optional ngrok tunnel.",
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder --dir",
    "dist": "npm run build:renderer && electron-builder",
    "dist:win": "npm run build:renderer && electron-builder --win nsis",
    "lint": "eslint .",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:matrix": "node tests/compat.matrix.mjs",
    "check": "npm run test && npm run lint && npm run build:renderer"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "@ngrok/ngrok": "^1.5.0",
    "express": "^5.1.0",
    "mysql2": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "vite": "^7.1.0",
    "wait-on": "^8.0.4"
  }
}
