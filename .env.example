# Optional development defaults only. The desktop app stores secrets using Electron safeStorage.

MCP_PORT=3001

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# utf8mb4 maps to utf8mb4_general_ci, the widest collation that exists on every
# supported server. utf8mb4_0900_ai_ci (MySQL 8.0+) is rejected by older servers.
MYSQL_COLLATION=utf8mb4

# Windows named pipe, e.g. \\.\pipe\mysql. When set it replaces host and port.
MYSQL_SOCKET_PATH=

# off | required | verify-ca | verify-full
MYSQL_TLS_MODE=off
MYSQL_CA_FILE=
MYSQL_CERT_FILE=
MYSQL_KEY_FILE=
# TLSv1 is only needed by pre-2019 servers.
MYSQL_MIN_TLS_VERSION=
# Legacy servers may need DEFAULT@SECLEVEL=0.
MYSQL_CIPHERS=

# auto | mysql_native_password | caching_sha2_password | sha256_password
MYSQL_AUTH_PLUGIN=auto
MYSQL_ALLOW_TLS_FALLBACK=true
MYSQL_SESSION_TIME_ZONE=+00:00
MYSQL_SQL_MODE=
MYSQL_GROUP_CONCAT_MAX_LEN=0

NGROK_AUTHTOKEN=
NGROK_DOMAIN=
